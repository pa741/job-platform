<Project>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Warnings are not errors, because Semantic Kernel's Microsoft.Extensions.AI bridge is
         marked experimental (SKEXP0001) and emits a diagnostic that cannot be silenced
         without either this or a per-project NoWarn. Semantic Kernel is a deliberate
         architectural choice here, so the build accommodates it rather than the reverse.
         Warnings still surface in build output and in CI logs. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
