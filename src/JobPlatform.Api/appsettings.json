{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "AllowAnonymousReads": false,
    "AllowedOrigins": [],
    "EnableApiExplorer": false
  },
  "Cache": {
    "Enabled": true,
    "PostingsSeconds": 30,
    "MetricsSeconds": 60,
    "FacetsSeconds": 300
  },
  "RateLimit": {
    "Enabled": true,
    "ReadsPerMinute": 120,
    "MatchesPerMinute": 10
  },
  "Matching": {
    "Provider": "keyword",
    "RetrievalLimit": 400,
    "RerankLimit": 40,
    "DefaultTopN": 10,
    "MaxTopN": 50,
    "DescriptionCharacterBudget": 1500,
    "Anthropic": {
      "Model": "claude-opus-5",
      "Effort": "medium",
      "MaxTokens": 8000,
      "TimeoutSeconds": 90
    }
  },
  "Cosmos": {
    "DatabaseName": "jobplatform",
    "MetricsContainerName": "metrics"
  }
}
