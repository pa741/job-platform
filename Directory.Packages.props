<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Azure Functions">
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.0.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.5" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Blobs" Version="6.6.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Queues" Version="5.5.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.0.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="2.0.0" />
    <PackageVersion Include="Microsoft.ApplicationInsights.WorkerService" Version="2.22.0" />
  </ItemGroup>

  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Azure.Cosmos" Version="3.46.0" />
    <!-- The Cosmos SDK needs Newtonsoft.Json at runtime even when item serialization is
         configured to use System.Text.Json, so it is referenced explicitly rather than
         left to a transitive resolution that trimming/publish can drop. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup Label="Realtime">
    <!-- The push half of the dashboard. The Management SDK rather than the Functions SignalR
         binding, because there are two callers: the ingest function broadcasts and the API
         negotiates, and a binding serves only the first. One library authenticated one way
         beats a binding and a library authenticated two ways. -->
    <PackageVersion Include="Microsoft.Azure.SignalR.Management" Version="1.29.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.CosmosDB" Version="4.11.0" />
  </ItemGroup>

  <ItemGroup Label="Azure SDK">
    <PackageVersion Include="Azure.Identity" Version="1.13.1" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.23.0" />
    <PackageVersion Include="Azure.Storage.Queues" Version="12.22.0" />
    <!-- MIT. Columnar, typed, and readable by DuckDB, pandas, Fabric and Synapse
         serverless with nothing running - which is the whole point of the curated zone. -->
    <PackageVersion Include="Parquet.Net" Version="6.1.0" />
  </ItemGroup>

  <!-- Microsoft.Extensions.* sits on the 10.x line, ahead of the net9.0 target framework.
       Semantic Kernel and its Azure OpenAI connector depend on Microsoft.Extensions.AI 10.5,
       which requires it; with CentralPackageTransitivePinningEnabled on, leaving these at
       9.0.0 downgrades the transitive resolution and the build fails with CS1705. The 10.x
       packages carry net9.0 assets, so the target framework does not have to move. -->
  <ItemGroup Label="Common">
    <PackageVersion Include="CsvHelper" Version="33.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="API">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.20" />
    <PackageVersion Include="Microsoft.Identity.Web" Version="3.15.1" />
    <PackageVersion Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />
  </ItemGroup>

  <ItemGroup Label="AI">
    <!-- Semantic Kernel is the orchestration layer: Kernel, IChatCompletionService,
         ChatHistory and prompt templates. The Microsoft.SemanticKernel metapackage already
         carries Connectors.AzureOpenAI, so the connector under the Kernel is first-party and
         GA - which is what let the hand-composed Anthropic transport, and the API key it
         needed, be deleted outright rather than abstracted over. -->
    <PackageVersion Include="Microsoft.SemanticKernel" Version="1.80.0" />
    <!-- The official OpenAI library, for the batch extraction path only. Azure OpenAI is
         reached through Semantic Kernel's connector above and needs nothing from here; this is
         for api.openai.com, where the gpt-5.6 family is batch-capable and Azure's batch matrix
         does not yet carry it. -->
    <PackageVersion Include="OpenAI" Version="2.13.0" />
  </ItemGroup>

  <ItemGroup Label="MCP">
    <!-- The agent surface. The official C# SDK's ASP.NET Core host: streamable HTTP, stateless
         by default in the 2.x line, which is what suits a container that scales to zero - there
         are no sticky sessions to keep. Referenced by JobPlatform.Api alone; nothing in Core,
         Data or Ingestion knows this exists. -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup Label="Documents">
    <!-- BSD-2-Clause. The model writes markdown; this parses it into an AST the renderer
         walks. Nothing here ever runs on model output as HTML. -->
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <!-- MIT, and deliberately the platform-independent build rather than -gdi: the API runs
         in a Linux container with no GDI+ and no system fonts to draw through. -->
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.0" />
  </ItemGroup>

</Project>
