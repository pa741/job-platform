# Copy to .env.local (gitignored). None of these are secrets: a SPA client id is public
# by design, and the API is what enforces authorisation.
VITE_API_BASE_URL=https://<container-app>.<region>.azurecontainerapps.io
VITE_ENTRA_TENANT_ID=<tenant-id>
VITE_ENTRA_CLIENT_ID=<spa-app-registration-client-id>
VITE_API_SCOPE=api://<api-app-registration-client-id>/Jobs.Read
